{
  "screenWidth": 3440,
  "screenHeight": 1440,
  "monitorIndex": null,
  "width": 912,
  "anchor": "right",
  "bounds": null,
  "columns": 2,
  "fontScale": 1.0,
  "opacity": 1.0,
  "pingHost": "1.1.1.1",
  "gpuLimiterSensor": "^d?GPU \\[#\\d+\\]",
  "wheaSensor": "WHEA",

  "sections": [
    { "name": "GPU",      "color": "#76B900", "column": 0 },
    { "name": "CPU",      "color": "#FF7043", "column": 0 },
    { "name": "MEMORY",   "color": "#AB82FF", "column": 1 },
    { "name": "BOARD",    "color": "#4DB6FF", "column": 1 },
    { "name": "STORAGE",  "color": "#FFCA28", "column": 1 },
    { "name": "DRIVE HEALTH", "color": "#C6E06B", "column": 1 },
    { "name": "NETWORK",  "color": "#26DED2", "column": 1 },
    { "name": "FRAMES",   "color": "#FF63B4", "column": 1 }
  ],

  "metrics": [
    { "section": "GPU", "label": "Load", "unit": "%", "format": "0", "min": 0, "max": 100,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU (Core Load|Utilization)$" } ] },
    { "section": "GPU", "label": "Core temp", "unit": "°C", "format": "0", "min": 25, "max": 90, "warn": 75, "crit": 83,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Temperature$" } ] },
    { "section": "GPU", "label": "Hotspot", "unit": "°C", "format": "0", "min": 25, "max": 110, "warn": 90, "crit": 100,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Hot ?[Ss]pot Temperature$" } ] },
    { "section": "GPU", "label": "VRAM junction", "unit": "°C", "format": "0", "min": 25, "max": 110, "warn": 95, "crit": 104,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Memory Junction Temperature$" } ] },
    { "section": "GPU", "label": "Power", "unit": "W", "format": "0", "min": 0, "max": 0,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Power$" },
                   { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^(Total Board Power|GPU ASIC Power)" } ] },
    { "section": "GPU", "label": "Core clock", "unit": "MHz", "format": "0", "min": 0, "max": 0,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Effective Clock$" },
                   { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Clock$" } ] },
    { "section": "GPU", "label": "VRAM used", "unit": "GB", "format": "0.0", "min": 0, "max": 0, "scale": 0.0009765625,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Memory Allocated$" },
                   { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU D3D Memory Dedicated$" } ] },
    { "section": "GPU", "label": "Fan", "unit": "%", "format": "0", "min": 0, "max": 100, "warn": 85, "crit": 95,
      "sources": [ { "sensor": "^d?GPU \\[#\\d+\\]", "label": "^GPU Fan ?1?$", "unit": "%" } ] },

    { "section": "CPU", "label": "Load", "unit": "%", "format": "0", "min": 0, "max": 100,
      "sources": [ { "sensor": "^CPU \\[#0\\]", "label": "^Total CPU Usage$" } ] },
    { "section": "CPU", "label": "Busiest thread", "unit": "%", "format": "0", "min": 0, "max": 100,
      "sources": [ { "sensor": "^CPU \\[#0\\]", "label": "^Max CPU/Thread Usage$" } ] },
    { "section": "CPU", "label": "Effective clock", "unit": "MHz", "format": "0", "min": 0, "max": 0,
      "sources": [ { "sensor": "^CPU \\[#0\\]", "label": "^Average Effective Clock$" } ] },
    { "section": "CPU", "label": "CPU temp", "unit": "°C", "format": "0", "min": 25, "max": 100, "warn": 85, "crit": 95,
      "sources": [ { "sensor": "^CPU \\[#0\\]", "label": "^CPU \\(Tctl/Tdie\\)$" },
                   { "sensor": "^CPU \\[#0\\]", "label": "^CPU Package$" } ] },
    { "section": "CPU", "label": "CCD1 temp", "unit": "°C", "format": "0", "min": 25, "max": 100, "warn": 85, "crit": 95,
      "sources": [ { "sensor": "^CPU \\[#0\\]", "label": "^CPU CCD1 \\(Tdie\\)$" } ] },
    { "section": "CPU", "label": "CCD2 temp", "unit": "°C", "format": "0", "min": 25, "max": 100, "warn": 85, "crit": 95,
      "sources": [ { "sensor": "^CPU \\[#0\\]", "label": "^CPU CCD2 \\(Tdie\\)$" } ] },
    { "section": "CPU", "label": "Package power", "unit": "W", "format": "0", "min": 0, "max": 0,
      "sources": [ { "sensor": "^CPU \\[#0\\]", "label": "^CPU Package Power$" } ] },

    { "section": "MEMORY", "label": "RAM used", "unit": "GB", "format": "0.0", "min": 0, "max": 0, "scale": 0.0009765625,
      "sources": [ { "sensor": "^System", "label": "^Physical Memory Used$" } ] },
    { "section": "MEMORY", "label": "Commit", "unit": "GB", "format": "0", "min": 0, "max": 0, "scale": 0.0009765625,
      "sources": [ { "sensor": "^System", "label": "^Virtual Memory Committed$" } ] },
    { "section": "MEMORY", "label": "DIMM temp (hottest)", "unit": "°C", "format": "0.0", "min": 25, "max": 85, "warn": 60, "crit": 75, "agg": "max",
      "sources": [ { "sensor": "^DDR\\d DIMM", "label": "Temperature" } ] },

    { "section": "BOARD", "label": "VRM", "unit": "°C", "format": "0", "min": 25, "max": 110, "warn": 85, "crit": 100,
      "sources": [ { "label": "^VRM( MOS)?( Temperature)?$", "unit": "C$" } ] },
    { "section": "BOARD", "label": "Chipset", "unit": "°C", "format": "0", "min": 25, "max": 100, "warn": 75, "crit": 90, "agg": "max",
      "sources": [ { "label": "^(Chipset|PCH)", "unit": "C$" } ] },
    { "section": "BOARD", "label": "CPU fan / pump", "unit": "RPM", "format": "0", "min": 0, "max": 0,
      "sources": [ { "label": "^(CPU|CPU[ _]Fan|CPU[ _]OPT|Pump|AIO Pump)$", "unit": "RPM" } ] },

    { "section": "STORAGE", "label": "C: drive temp", "unit": "°C", "format": "0", "min": 20, "max": 85, "warn": 65, "crit": 75, "agg": "max",
      "sources": [ { "sensor": "^S\\.M\\.A\\.R\\.T\\..*\\[[^\\]]*C:", "label": "^Drive Temperature" } ] },
    { "section": "STORAGE", "label": "Hottest drive", "unit": "°C", "format": "0", "min": 20, "max": 85, "warn": 65, "crit": 75, "agg": "max",
      "sources": [ { "sensor": "^S\\.M\\.A\\.R\\.T\\.", "label": "^Drive Temperature" } ] },
    { "section": "STORAGE", "label": "C: read+write", "unit": "MB/s", "format": "0", "min": 0, "max": 0, "agg": "sum",
      "sources": [ { "sensor": "^Drive:.*\\[[^\\]]*C:", "label": "^(Read|Write) Rate$" } ] },
    { "section": "STORAGE", "label": "All drives read+write", "unit": "MB/s", "format": "0", "min": 0, "max": 0, "agg": "sum",
      "sources": [ { "sensor": "^Drive:", "label": "^(Read|Write) Rate$" } ] },

    { "section": "DRIVE HEALTH", "label": "C: life remaining", "unit": "%", "format": "0", "min": 0, "max": 100, "warn": 20, "crit": 10, "lowIsBad": true, "agg": "min",
      "sources": [ { "sensor": "^S\\.M\\.A\\.R\\.T\\..*\\[[^\\]]*C:", "label": "^Drive Remaining Life$" } ] },
    { "section": "DRIVE HEALTH", "label": "Lowest drive life (all)", "unit": "%", "format": "0", "min": 0, "max": 100, "warn": 20, "crit": 10, "lowIsBad": true, "agg": "min",
      "sources": [ { "sensor": "^S\\.M\\.A\\.R\\.T\\.", "label": "^Drive Remaining Life$" } ] },

    { "section": "NETWORK", "label": "Download", "unit": "Mbps", "format": "0.0", "min": 0, "max": 0, "agg": "sum", "scale": 0.008,
      "sources": [ { "sensor": "^Network:", "label": "^Current DL rate$" } ] },
    { "section": "NETWORK", "label": "Upload", "unit": "Mbps", "format": "0.0", "min": 0, "max": 0, "agg": "sum", "scale": 0.008,
      "sources": [ { "sensor": "^Network:", "label": "^Current UP rate$" } ] },
    { "section": "NETWORK", "label": "Ping", "unit": "ms", "format": "0", "min": 0, "max": 0, "warn": 60, "crit": 150, "special": "ping" },

    { "section": "FRAMES", "label": "Framerate", "unit": "FPS", "format": "0", "min": 0, "max": 0,
      "sources": [ { "sensor": "^RTSS$", "label": "^Framerate$" } ] }
  ]
}
